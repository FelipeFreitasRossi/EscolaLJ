# Copie este arquivo para ".env" (comando no CMD: copy .env.example .env)
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

APP_NAME=Escola de Futebol LJ API
ENVIRONMENT=development

# Endereço do frontend em desenvolvimento (Vite). Separe vários com vírgula.
CORS_ORIGINS=http://localhost:5173

# MongoDB Atlas — deixe vazio até configurarmos o Atlas na Fase 2.
MONGODB_URI=
MONGODB_DB_NAME=escola_lj
